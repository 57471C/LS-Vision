.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
__pycache__/
*.pyc
# Local BoM source choice. Absent file means the JSON sample BoM.
vision/bom-source.json
vision/bom_queries.sql
# Local settings written by the Settings page. Copy vision/config.example.json to start.
vision/config.local.json
vision/config.local.json.tmp
# DINOv2 reference embeddings captured on this bench. Next to config.local.json.
vision/dinov2-references.json
vision/dinov2-references.json.tmp
# Trained weights stay on the machine. Place best.pt in vision/models/.
vision/models/*.pt
vision/models/*.onnx
# Sidecar startup and camera errors, including launches from the packaged exe.
vision/sidecar.log
# Temporary frame saved by decode_barcode while barcode misses are being traced.
vision/debug-barcode.jpg
vision/barcode-debug.log
# Model runs
runs/

# Optional DINOv2 weights next to the Tauri crate. YOLO models stay in app data.
src-tauri/models/
# OpenVINO runtime the installer copies next to the exe. Too large for git.
src-tauri/openvino/
# Local OpenVINO plugin hunt: error log, pyke archive, and the Python wheel extract.
/ov-error.txt
src-tauri/ov-extract/
vision/ov_wheel/
vision/*.whl
